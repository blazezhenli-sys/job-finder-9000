NODE_ENV=production
PORT=3000
APP_PORT=3000
DATABASE_URL=postgres://hiring:hiring@db:5432/hiring
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-password

# Start these sources automatically in the worker.
ENABLE_POSTS=false
ENABLE_BLUESKY=true
BLUESKY_JETSTREAM_URL=wss://jetstream1.us-east.bsky.network/subscribe?wantedCollections=app.bsky.feed.post
ENABLE_HACKER_NEWS=true
HN_POLL_INTERVAL_MS=30000

# Optional social sources. Each Mastodon endpoint needs a token issued by that same instance.
ENABLE_MASTODON=false
MASTODON_ENDPOINTS=["mastodon.social","hachyderm.io","infosec.exchange"]
MASTODON_TOKENS_JSON={"mastodon.social":"","hachyderm.io":"","infosec.exchange":""}
# Legacy single-instance settings remain supported: MASTODON_INSTANCES and MASTODON_ACCESS_TOKEN.

# Reddit uses an OAuth application-only client and polls selected subreddits.
ENABLE_REDDIT=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hiring-signal-discovery/0.1 by personal-use
REDDIT_SUBREDDITS=forhire,startups,Entrepreneur,remotejs
REDDIT_POLL_INTERVAL_MS=60000
ENABLE_LISTINGS=true
LISTINGS_POLL_INTERVAL_MS=3600000
LISTINGS_POLL_CONCURRENCY=4
ENABLE_LISTING_DISCOVERY=true
LISTING_DISCOVERY_INTERVAL_MS=86400000
LISTING_DISCOVERY_VALIDATION_CONCURRENCY=4
REMOTIVE_POLL_INTERVAL_SECONDS=21600
# Optional broad job-search source. Leave blank to disable Adzuna.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=us,gb,au,sg
ADZUNA_QUERY=software engineer developer backend full stack
ADZUNA_WHERE=
ADZUNA_POLL_INTERVAL_SECONDS=3600

# SMTP credentials are server-side only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=

# Development-only sample ingestion route and old-post behavior.
DEV_MODE=false
NOTIFY_RECOVERED=false
RETENTION_DAYS=30
